---
import { render } from "astro:content";
import { formatIngredient, formatPeople } from "../../../components/Recipes/amount";
import { localeList, locales, recipeUrl } from "../../../components/Recipes/i18n";
import { fill } from "../../../components/Recipes/i18n/fill";
import Ingredient from "../../../components/Recipes/Ingredient.astro";
import IngredientList from "../../../components/Recipes/IngredientList.astro";
import IngredientReference from "../../../components/Recipes/IngredientReference.astro";
import { getRecipes, type Recipe } from "../../../components/Recipes/recipes";
import type { RecipeFrontmatter } from "../../../components/Recipes/remark-ingredients";
import Servings from "../../../components/Recipes/Servings.astro";
import Share from "../../../components/Recipes/Share.astro";
import HtmlLayout from "../../../layouts/HtmlLayout.astro";
import "../../../styles/transitions.css";

export async function getStaticPaths() {
  return (await getRecipes()).map((recipe) => ({
    params: { lang: recipe.lang, id: recipe.slug },
    props: { recipe },
  }));
}

interface Props {
  recipe: Recipe;
}

const { lang, slug, entry } = Astro.props.recipe;
const t = locales[lang];
const otherLocales = localeList.filter((other) => other !== lang);
const { title, description, difficulty, minutes, servings, diet } = entry.data;
const { Content, remarkPluginFrontmatter } = await render(entry);
const { ingredients, steps } = remarkPluginFrontmatter as RecipeFrontmatter;

const url = new URL(Astro.url.pathname, Astro.site);
const image = new URL(`${recipeUrl(lang, slug)}.png`, Astro.site);
const people = formatPeople(servings, t.people);
const minutesText = fill(t.minutes, { count: minutes });
const imageAlt = fill(t.recipe.imageAlt, {
  title,
  diet: t.diet[diet],
  minutes: minutesText,
  people,
});

// schema.org has no diet for pescetarian or omnivore.
const SCHEMA_DIETS: Partial<Record<typeof diet, string>> = {
  vegan: "https://schema.org/VeganDiet",
  vegetarian: "https://schema.org/VegetarianDiet",
};

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Recipe",
  name: title,
  description,
  inLanguage: lang,
  image: image.href,
  url: url.href,
  author: {
    "@type": "Person",
    name: "Derk-Jan Karrenbeld",
    url: new URL("/", Astro.site).href,
  },
  totalTime: `PT${minutes}M`,
  recipeYield: people,
  suitableForDiet: SCHEMA_DIETS[diet],
  recipeIngredient: ingredients.map((ingredient) =>
    formatIngredient(ingredient, 1, { lang, metric: true }),
  ),
  recipeInstructions: steps.map((text) => ({ "@type": "HowToStep", text })),
};
---

<HtmlLayout title={title} description={description} lang={lang}>
  <Fragment slot="head">
    {localeList.map((alternate) => (
      <link
        rel="alternate"
        hreflang={alternate}
        href={new URL(recipeUrl(alternate, slug), Astro.site)}
      />
    ))}
    <meta name="robots" content="noindex" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData).replaceAll("<", "\\u003c")}
    />
  </Fragment>

  <div class="p-6">
    <header class="prose sm:prose-xl mx-auto w-full max-w-prose px-0 py-8">
      <a
        href="#content"
        class="transition sr-only focus:not-sr-only rounded-md focus:fixed focus:top-4 focus:left-4 focus:dark:bg-zinc-900 focus:bg-zinc-100 focus:shadow-xl focus:outline-none focus:ring-2 focus:ring-pink-500 dark:focus:ring-yellow-500"
      >
        <span class="block p-2">{t.recipe.skip}</span>
      </a>
      <nav class="flex flex-wrap items-center justify-between gap-x-6">
        <a
          href={recipeUrl(lang)}
          class="transition group inline-flex space-x-1 items-center focus:outline-none focus:ring-2 focus:ring-pink-500 dark:focus:ring-yellow-500 rounded-md p-2 -mx-2"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5 motion-safe:group-hover:animate-bouncel motion-safe:group-focus:animate-bouncel"
            viewBox="0 0 20 20"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              fill-rule="evenodd"
              d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z"
              clip-rule="evenodd"
            ></path>
          </svg>
          <span>{t.recipe.back}</span>
        </a>
        {otherLocales.map((other) => (
          <a
            href={recipeUrl(other, slug)}
            hreflang={other}
            lang={other}
            class="transition focus:outline-none focus:ring-2 focus:ring-pink-500 dark:focus:ring-yellow-500 rounded-md p-2 -mx-2"
          >
            {locales[other].meta.languageName}
          </a>
        ))}
      </nav>
    </header>
  </div>

  <main class="p-6" id="content">
    <article class="prose prose-lg sm:prose-xl dark:prose-invert prose-zinc max-w-prose mx-auto">
      <header>
        <h1 class="font-extrabold text-5xl mb-4">{title}</h1>
        <p class="font-bold mt-0">
          {t.diet[diet]} · {t.difficulty[difficulty]} · {minutesText}
        </p>
      </header>

      <div class="not-prose flex flex-wrap items-center justify-between gap-4">
        <Servings servings={servings} />
        <Share title={title} text={description} />
      </div>

      <section aria-labelledby="ingredients">
        <h2 id="ingredients">{t.recipe.ingredients}</h2>
        <IngredientList ingredients={ingredients} />
      </section>

      <section aria-labelledby="steps">
        <h2 id="steps">{t.recipe.steps}</h2>
        <Content components={{ Ingredient, IngredientReference }} />
      </section>
    </article>
  </main>
</HtmlLayout>
