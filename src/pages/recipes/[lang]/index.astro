---
import { formatPeople } from "../../../components/Recipes/amount";
import {
  localeList,
  localeOf,
  locales,
  recipeUrl,
} from "../../../components/Recipes/i18n";
import { fill } from "../../../components/Recipes/i18n/fill";
import { getRecipes } from "../../../components/Recipes/recipes";
import HtmlLayout from "../../../layouts/HtmlLayout.astro";
import "../../../styles/transitions.css";

export function getStaticPaths() {
  return localeList.map((lang) => ({ params: { lang } }));
}

const lang = localeOf(Astro.params.lang);
const t = locales[lang];
const otherLocales = localeList.filter((other) => other !== lang);
const [beforeSite, afterSite] = t.index.heading.split("{site}");

const recipes = (await getRecipes())
  .filter((recipe) => recipe.lang === lang)
  .sort((a, b) => a.entry.data.title.localeCompare(b.entry.data.title, lang));
---

<HtmlLayout title={t.index.title} lang={lang}>
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
    {localeList.map((alternate) => (
      <link
        rel="alternate"
        hreflang={alternate}
        href={new URL(recipeUrl(alternate), Astro.site)}
      />
    ))}
  </Fragment>

  <main id="content" class="mx-auto w-full max-w-5xl px-5 py-8">
    <header class="px-4">
      <p class="mb-4 font-semibold">
        {otherLocales.map((other) => (
          <a
            href={recipeUrl(other)}
            hreflang={other}
            lang={other}
            class="inline-block py-0.5"
          >
            {locales[other].meta.languageName}
          </a>
        ))}
      </p>
      <!-- prettier-ignore -->
      <h1 class="text-5xl font-bold">
        {beforeSite}<a href="/" lang="en">Bits and Pieces</a>{afterSite}
      </h1>
      <p class="text-xl mt-1">{t.index.lead}</p>
    </header>

    <ol class="mt-12 space-y-6" role="list">
      {recipes.map(({ slug, entry }) => (
        <li>
          <article class="transition p-4 focus-within:ring-2 focus-within:ring-pink-500 dark:focus-within:ring-yellow-500 max-w-2xl rounded-md">
            <header>
              <h2>
                <a
                  href={recipeUrl(lang, slug)}
                  class="text-3xl font-semibold no-underline focus:outline-none"
                  aria-describedby={`${slug}-description`}
                  data-astro-prefetch
                >
                  {/*transition:animate="slide"
                      transition:name={md5(article.id)}
                      */}
                  <span>
                    {entry.data.published === false ? `${t.index.draft} ` : ""}
                    {entry.data.title}
                  </span>
                </a>
              </h2>
              <span class="text-zinc-600 dark:text-zinc-400">
                {fill(t.summary, {
                  diet: t.diet[entry.data.diet],
                  minutes: fill(t.minutes, { count: entry.data.minutes }),
                  people: formatPeople(entry.data.servings, t.people),
                })}
              </span>
            </header>
            <p id={`${slug}-description`} class="mt-2 text-xl">
              {entry.data.description}
            </p>
          </article>
        </li>
      ))}
    </ol>
  </main>
</HtmlLayout>
