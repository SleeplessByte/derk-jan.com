---
import { Image } from "astro:assets";
import HtmlLayout from "../../../../layouts/HtmlLayout.astro";
import LyricsOverlay from "../../../../components/Lyrics/Overlay.astro";
import LyricsTranscript from "../../../../components/Lyrics/Transcript.astro";
import AddToCalendar from "../_components/AddToCalendar/Component.astro";
import Countdown from "../_components/Countdown/Component.astro";
import OrderTicket from "../_components/OrderTicket/Component.astro";
import { localeList, localeOf, locales } from "../_i18n";

import backgroundImage from "../../../../assets/kate-laine-9kNC6g-emEQ-unsplash.jpg";
import successVideoAv1 from "../../../../assets/video/coffee-magic-20261115.webm";
import successVideoMp4 from "../../../../assets/video/coffee-magic-20261115.mp4";
import successCaptionsEn from "../../../../assets/video/coffee-magic-20261115.en.vtt?url";
import successCaptionsNl from "../../../../assets/video/coffee-magic-20261115.nl.vtt?url";
import fruityXmasM4a from "../../../../assets/audio/2026-fruity-xmas.m4a?url";
import fruityXmasMp3 from "../../../../assets/audio/2026-fruity-xmas.mp3";
import fruityXmasLyrics from "../../../../assets/audio/2026-fruity-xmas.lyrics.json";
import fruityXmasVtt from "../../../../assets/audio/2026-fruity-xmas.vtt?url";
import sideVideoMp4 from "../../../../assets/video/coffee-snow-20261116.mp4";

export function getStaticPaths() {
  return localeList.map((lang) => ({ params: { lang } }));
}

const lang = localeOf(Astro.params.lang);
const t = locales[lang];
const successCaptions: Record<typeof lang, string> = {
  en: successCaptionsEn,
  nl: successCaptionsNl,
};
---

<HtmlLayout title={t.meta.title} description={t.meta.description} lang={lang}>
  <div class="relative">
    <div
      class="lg:fixed lg:inset-0 lg:left-1/2 shadow-xl dark:shadow-2xl"
      transition:name="side"
    >
      <Image
        src={backgroundImage}
        alt=""
        class="h-64 w-full bg-zinc-50 object-[center_80%] md:object-[center_75%] lg:object-center object-cover sm:h-80 lg:absolute lg:h-full dark:bg-zinc-800"
        loading="eager"
        data-target="side"
      />
    </div>
    <div class="pt-16 pb-24 sm:pt-24 sm:pb-32 lg:mx-auto lg:grid lg:max-w-7xl lg:grid-cols-2 lg:pt-32">
      <div class="px-6 lg:px-8">
        <div class="mx-auto max-w-xl lg:mx-0 lg:max-w-lg [--lyrics-accent:var(--color-orange-700)] [--lyrics-ring:var(--color-pink-600)] dark:[--lyrics-accent:var(--color-pink-300)] dark:[--lyrics-ring:var(--color-orange-600)] [--lyrics-scrim:oklch(17%_0.02_40)]">
          <header>
            <h2 class="text-4xl font-semibold tracking-tight text-pretty text-zinc-900 sm:text-4xl dark:text-white">
              {t.success.heading}
            </h2>
            <p class="mt-2 text-lg/8 text-zinc-600 dark:text-zinc-300"></p>
            <p
              class="mt-2 text-lg/8 text-zinc-600 dark:text-zinc-300"
              set:html={t.success.reminder}
            />
          </header>

          <figure class="relative pb-16 -ml-2 pl-2">
            <div class="relative">
              <video
                class="aspect-square rounded-xl shadow-md object-cover my-4"
                autoplay
                controls
                controlslist="nodownload nofullscreen noremoteplayback"
                disablepictureinpicture
                disableRemotePlayback
                playsinline
              >
                <source type="video/webm" src={successVideoAv1} />
                <source type="video/mp4" src={successVideoMp4} />
                <track
                  kind="captions"
                  src={successCaptions[lang]}
                  srclang={lang}
                  label={t.meta.languageName}
                />
              </video>
              <LyricsOverlay lyrics={fruityXmasLyrics} />
            </div>

            <audio
              controls
              class="absolute bottom-2 left-2"
              data-target="song"
              transition:name="audio"
              transition:persist
            >
              <source src={fruityXmasM4a} type='audio/mp4; codecs="mp4a.40.2"' />
              <source src={fruityXmasM4a} type="audio/mp4" />
              <source src={fruityXmasMp3} type="audio/mpeg" />
              <track
                kind="captions"
                src={fruityXmasVtt}
                srclang="en"
                label="Fruity Xmas"
              />
            </audio>
          </figure>
          <LyricsTranscript
            lyrics={fruityXmasLyrics}
            summary={t.transcript.summary}
            hint={t.transcript.hint}
          />

          <p
            class="mt-2 text-lg text-orange-600 dark:text-pink-400 [&_strong]:text-orange-700 dark:[&_strong]:text-pink-300"
            set:html={t.hours.future}
          />
          <Countdown />

          <AddToCalendar />

          <div class="mt-10">
            <OrderTicket source="saved" />
          </div>

          <div class="mt-10 flex justify-between items-start border-t border-zinc-900/10 pt-8 dark:border-white/10 gap-2">
            <p class="dark:text-zinc-300">{t.form.addressNote}</p>

            <a
              href="mailto:derk-jan@karrenbeld.info?subject=RSVP Gay Café 2026"
              class="no-underline transition shrink-0 rounded-md pointer bg-pink-600 dark:bg-orange-700 px-3.5 py-2.5 text-center text-sm font-semibold text-white shadow-xs hover:shadow-md active:shadow-none dark:shadow-lg dark:hover:shadow-xl dark:active:shadow-sm hover:bg-pink-500 dark:hover:bg-orange-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pink-600 dark:focus-visible:outline-orange-600 active:bg-pink-700 dark:active:bg-orange-800 hover:-translate-y-px active:translate-y-px"
            >
              {t.success.change}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script
    data-astro-rerun
    data-target="variables"
    data-variable-side-video-mp4={sideVideoMp4}
  >
    {
      const variables = document.querySelector('[data-target="variables"]');
      const sideElement = document.querySelector('[data-target="side"]');
      const replacementVideo = document.createElement("video");

      let replacementVideoLoaded = false;
      let replacementVideoPlayed = false;

      replacementVideo.setAttribute("transition:persist", "");
      replacementVideo.autoplay = true;
      replacementVideo.muted = true;
      replacementVideo.loop = true;
      replacementVideo.addEventListener(
        "canplaythrough",
        () => {
          replacementVideo.setAttribute("class", sideElement.getAttribute("class"));
          sideElement.replaceWith(replacementVideo);
          replacementVideo
            .play()
            .then(() => {
              replacementVideoPlayed = true;
            })
            .catch(() => {
              replacementVideoLoaded = true;
            });
        },
        { once: true },
      );
      replacementVideo.src = variables.dataset.variableSideVideoMp4;

      document.addEventListener(
        "click",
        () => {
          if (replacementVideoLoaded && !replacementVideoPlayed) {
            replacementVideo.play();
            replacementVideoPlayed = true;
          }
        },
        { once: true },
      );
    }
  </script>
</HtmlLayout>
