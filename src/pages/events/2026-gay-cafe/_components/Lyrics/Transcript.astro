---
import lyrics from "../../../../../assets/audio/2026-fruity-xmas.lyrics.json";

const hintId = `lyrics-transcript-${crypto.randomUUID()}-hint`;
const stanzas = lyrics.stanzas.map((lines) =>
  lines.map((line) => ({
    start: line.start,
    text: line.words.map(([word]) => word).join(" "),
  })),
);
---

<!-- The text alternative for the song (WCAG 1.2.1); the overlay is only a visual copy. -->
<details data-component="lyrics-transcript" class="mt-2 text-zinc-700 dark:text-zinc-300">
  <summary class="w-fit cursor-pointer rounded-md font-semibold text-orange-700 dark:text-pink-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pink-600 dark:focus-visible:outline-orange-600">
    Read the lyrics of “Fruity Xmas”
  </summary>
  <p id={hintId} class="hint mt-2 text-sm text-zinc-600 dark:text-zinc-400" hidden>
    Choose a line to play the song from there.
  </p>
  {stanzas.map((lines) => (
    <p class="mt-3">
      {lines.map((line, index) => (
        <>
          <span class="line" data-start={line.start}>
            {line.text}
          </span>
          {index < lines.length - 1 && <br />}
        </>
      ))}
    </p>
  ))}
</details>

<script>
  import { setupTranscript } from "./transcript";

  setupTranscript();
  document.addEventListener("astro:after-swap", setupTranscript);
</script>

<style>
  [data-component="lyrics-transcript"] {
    --transcript-accent: var(--color-orange-700);
    --transcript-ring: var(--color-pink-600);

    @media (prefers-color-scheme: dark) {
      --transcript-accent: var(--color-pink-300);
      --transcript-ring: var(--color-orange-600);
    }

    /* transcript.ts turns the lines into these buttons, so they are not in the scope. */
    & :global(button.line) {
      display: inline-block;
      padding-block: 0.125rem;
      border-radius: 0.25rem;
      text-align: start;
      text-decoration: underline 1px transparent;
      text-underline-offset: 0.2em;
      cursor: pointer;
      transition:
        color 0.15s ease,
        text-decoration-color 0.15s ease;

      &:hover {
        color: var(--transcript-accent);
        text-decoration-color: currentColor;
      }

      &:focus-visible {
        outline: 2px solid var(--transcript-ring);
        outline-offset: 2px;
      }
    }
  }
</style>
