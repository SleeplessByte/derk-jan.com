---
import { localeOf, locales, pageUrl } from "../../_i18n";

interface Props {
  placement: "opener" | "header";
}

const { placement } = Astro.props;
const lang = localeOf(Astro.params.lang);
const t = locales[lang].handover;

const SHORT_LINK = "derk-jan.com/cafe";

const url = new URL(pageUrl(lang), Astro.site).href;
const mail = `mailto:?subject=${encodeURIComponent(t.subject)}&body=${encodeURIComponent(`${t.shareText}\r\n\r\n${url}`)}`;
const [beforeLink, afterLink] = t.type.split("{url}");
---

<!-- Phones and tablets only -->
<p data-component="handover" class:list={[placement === "opener" && "--opener"]}>
  <span class="lead">{t.lead}</span>{" "}
  <a
    class="send unstyled-link"
    href={mail}
    data-title={t.subject}
    data-text={t.shareText}
    data-url={url}
  >
    {t.send}
  </a>{" "}
  <!-- A line break inside would put a space around the address. -->
  <!-- prettier-ignore -->
  <span class="type">{beforeLink}<strong>{SHORT_LINK}</strong>{afterLink}</span>
</p>

<script>
  import { setupHandover } from "./handover";

  setupHandover();
  document.addEventListener("astro:after-swap", setupHandover);
</script>

<style>
  [data-component="handover"] {
    --handover-ink: var(--color-zinc-600);
    --handover-accent: var(--color-pink-600);

    margin: 0;
    color: var(--handover-ink);
    font-size: 0.875rem;
    line-height: 1.75;

    @media (prefers-color-scheme: dark) {
      --handover-ink: var(--color-zinc-300);
      --handover-accent: var(--color-orange-400);
    }

    & .send {
      display: inline-flex;
      align-items: center;
      min-block-size: 1.75rem;
      padding-inline: 0.75rem;
      border: 1px solid currentColor;
      border-radius: 999px;
      color: var(--handover-accent);
      font-weight: 600;
      text-decoration: none;
      white-space: nowrap;

      &:focus-visible {
        outline: 2px solid var(--handover-accent);
        outline-offset: 2px;
      }
    }

    & .type strong {
      font-weight: 600;
      white-space: nowrap;
    }

    &.--opener {
      --handover-ink: var(--opener-gold-light);
      --handover-accent: var(--opener-gold);

      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      text-align: center;
      text-wrap: balance;
    }

    @media (hover: hover) {
      &,
      &.--opener {
        display: none;
      }
    }
  }
</style>
