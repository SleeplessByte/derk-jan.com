---
import { icons, type IconName } from "./icons";

interface Props {
  name: IconName;
}

const { name } = Astro.props;
const icon = icons[name];
---

<svg
  data-component="form-icon"
  data-icon={name}
  class="relative top-1 mr-1 size-6 shrink-0 md:size-4"
  viewBox={icon.viewBox}
  fill="none"
  aria-hidden="true"
>
  {icon.parts.map((part) => (
    <path
      class:list={[part.tone, "motion" in part && `--${part.motion}`]}
      d={part.d}
      fill-rule={"evenOdd" in part && part.evenOdd ? "evenodd" : undefined}
      clip-rule={"evenOdd" in part && part.evenOdd ? "evenodd" : undefined}
      style={"origin" in part ? `transform-origin: ${part.origin}` : undefined}
    />
  ))}
</svg>

<style>
  [data-component="form-icon"] {
    --icon-light: #8fbffa;
    --icon-dark: #2859c5;

    --icon-coffee: oklch(42% 0.07 55);
    --icon-crema: oklch(72% 0.11 65);
    --icon-foam: oklch(96% 0.02 85);
    --icon-chocolate: oklch(35% 0.06 45);
    --icon-tea: oklch(72% 0.13 70);
    --icon-mint-tea: oklch(80% 0.12 125);
    --icon-ginger: oklch(88% 0.12 95);
    --icon-ginger-skin: oklch(66% 0.11 75);
    --icon-mint: oklch(62% 0.15 150);
    --icon-wine: oklch(45% 0.16 15);

    & .light {
      fill: var(--icon-light);
    }

    & .dark {
      fill: var(--icon-dark);
    }

    & .coffee {
      fill: var(--icon-coffee);
    }

    & .crema {
      fill: var(--icon-crema);
    }

    & .foam {
      fill: var(--icon-foam);
    }

    & .chocolate {
      fill: var(--icon-chocolate);
    }

    /* Whipped cream is nearly white, so it needs an edge on a light page. */
    & .cream {
      fill: var(--icon-foam);
      stroke: var(--icon-dark);
      stroke-width: 0.45;
    }

    & .tea {
      fill: var(--icon-tea);
    }

    & .mint-tea {
      fill: var(--icon-mint-tea);
    }

    & .ginger {
      fill: var(--icon-ginger);
    }

    & .ginger-skin {
      fill: var(--icon-ginger-skin);
    }

    & .mint {
      fill: var(--icon-mint);
    }

    & .wine {
      fill: var(--icon-wine);
    }

    & .steam,
    & .string,
    & .stem {
      fill: none;
      stroke-linecap: round;
    }

    & .steam {
      stroke: var(--icon-light);
      stroke-width: 0.8;
    }

    & .string {
      stroke: var(--icon-dark);
      stroke-width: 0.45;
    }

    & .stem {
      stroke: var(--icon-mint);
      stroke-width: 0.55;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(input:checked + label) [data-component="form-icon"] {
      & .--rise {
        animation: form-icon-rise 1.4s ease-out;
      }

      & .--pop {
        animation: form-icon-pop 0.6s cubic-bezier(0.3, 1.6, 0.5, 1);
      }

      & .--drop {
        animation: form-icon-drop 1.1s ease-in 2;
      }

      & .--wobble {
        animation: form-icon-wobble 0.8s ease-out;
      }

      & .--sway {
        animation: form-icon-sway 1.2s ease-in-out;
      }

      & .--spin {
        animation: form-icon-spin 0.9s ease-out;
      }

      & .--tilt {
        animation: form-icon-tilt 1.2s ease-in-out;
      }
    }
  }

  @keyframes form-icon-rise {
    from {
      opacity: 0;
      translate: 0 1.5px;
    }
    40% {
      opacity: 1;
    }
  }

  @keyframes form-icon-pop {
    from {
      scale: 0;
    }
  }

  @keyframes form-icon-drop {
    from {
      opacity: 0;
      translate: 0 -1.5px;
    }
    30% {
      opacity: 1;
    }
    to {
      opacity: 0;
      translate: 0 2.5px;
    }
  }

  @keyframes form-icon-wobble {
    30% {
      scale: 1.12 0.88;
    }
    60% {
      scale: 0.95 1.06;
    }
  }

  @keyframes form-icon-sway {
    25% {
      rotate: -9deg;
    }
    75% {
      rotate: 7deg;
    }
  }

  @keyframes form-icon-spin {
    from {
      rotate: -180deg;
    }
  }

  @keyframes form-icon-tilt {
    30% {
      rotate: -10deg;
    }
    70% {
      rotate: 6deg;
    }
  }
</style>
