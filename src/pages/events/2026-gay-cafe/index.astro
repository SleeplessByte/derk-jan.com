---
import { Image } from "astro:assets";
import HtmlLayout from "../../../layouts/HtmlLayout.astro";

import Countdown from "./_components/Countdown/Component.astro";
import FormIcon from "./_components/FormIcon/Component.astro";
import LyricsOverlay from "./_components/Lyrics/Overlay.astro";
import LyricsTranscript from "./_components/Lyrics/Transcript.astro";
import Opener from "./_components/Opener/Component.astro";
import OrderTicket from "./_components/OrderTicket/Component.astro";
import RsvpReaction from "./_components/RsvpReaction/Component.astro";

import backgroundImage from "../../../assets/kate-laine-9kNC6g-emEQ-unsplash.jpg";
import kitchenImage from "../../../assets/IMG_20240825_233805_104.jpg";
import fruityXmasMp3 from "../../../assets/audio/2026-fruity-xmas.mp3";
import introVideoMp4 from "../../../assets/video/coffee-swirl-20261120-web.mp4";
import loopVideoMp4 from "../../../assets/video/coffee-snow-20261116.mp4";

// Astro only types WAI-ARIA 1.2 roles; graphics-symbol comes from the Graphics ARIA module.
const iconRole: Record<string, string> = { role: "graphics-symbol" };

const sideVideoClass =
  "absolute inset-0 size-full object-cover object-[center_80%] md:object-[center_75%] lg:object-center opacity-0";

const formName = "events/2026-gay-cafe";
const successPage = `/${formName}/success`;
const eventGate = 1798369200;
const signupGate = 1797634799;
---

<HtmlLayout title="RSVP to Gay Café 2026">
  <Opener />
  <div class="relative" data-target="content">
    <div
      class="relative lg:fixed lg:inset-0 lg:left-1/2 shadow-xl dark:shadow-2xl"
      transition:name="side"
    >
      <Image
        src={backgroundImage}
        alt=""
        class="h-64 w-full bg-zinc-50 object-[center_80%] md:object-[center_75%] lg:object-center object-cover sm:h-80 lg:absolute lg:h-full dark:bg-zinc-800"
        loading="eager"
      />
      <video
        class={sideVideoClass}
        data-target="side-loop"
        data-src={loopVideoMp4}
        preload="auto"
        muted
        loop
        playsinline
        aria-hidden="true"
      ></video>
      <video
        class={`${sideVideoClass} transition-opacity duration-1000 motion-reduce:transition-none`}
        data-target="side-intro"
        data-src={introVideoMp4}
        preload="auto"
        muted
        playsinline
        aria-hidden="true"
      ></video>
      <button
        type="button"
        class="absolute right-3 bottom-3 grid size-11 place-items-center rounded-full bg-zinc-950/70 text-white shadow-md transition hover:bg-zinc-950/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
        data-target="side-toggle"
        hidden
      >
        <svg
          {...iconRole}
          data-icon="pause"
          viewBox="0 0 24 24"
          fill="currentColor"
          class="size-5"
        >
          <title>Pause video</title>
          <path d="M7 4h3.5v16H7zM13.5 4H17v16h-3.5z"></path>
        </svg>
        <svg
          {...iconRole}
          data-icon="play"
          viewBox="0 0 24 24"
          fill="currentColor"
          class="hidden size-5"
        >
          <title>Play video</title>
          <path d="M7 4.5v15a1 1 0 0 0 1.5.86l12.5-7.5a1 1 0 0 0 0-1.72L8.5 3.64A1 1 0 0 0 7 4.5"></path>
        </svg>
      </button>
    </div>
    <div class="pt-16 pb-24 sm:pt-24 sm:pb-32 lg:mx-auto lg:grid lg:max-w-7xl lg:grid-cols-2 lg:pt-32">
      <div class="px-6 lg:px-8">
        <div class="mx-auto max-w-xl lg:mx-0 lg:max-w-lg">
          <header>
            <h2
              class="text-4xl font-semibold tracking-tight text-pretty text-zinc-900 sm:text-5xl dark:text-white focus:outline-none"
              tabindex="-1"
              data-target="heading"
            >
              Join us for a festive coffee and pastry
            </h2>
            <p class="mt-2 text-lg/8 text-zinc-600 dark:text-zinc-300">
              You{" "}
              <span data-target="tense" data-past="were">
                are
              </span>{" "}
              invited to enjoy and celebrate surviving another year{" "}
              <em>(in this climate?)</em>. We{" "}
              <span data-target="tense" data-past="served">
                will serve
              </span>{" "}
              coffee <em>(including milk alternatives)</em>, tea{" "}
              <em>(without microplastics)</em>, cake, pie, and pastries.
            </p>
            <p class="mt-2 text-lg/8 text-zinc-600 dark:text-zinc-300">
              The price{" "}
              <span data-target="tense" data-past="was">
                is
              </span>{" "}
              merely your attendance (it's free), monetary donations are welcome.
            </p>
          </header>

          <figure class="relative">
            <div class="relative">
              <Image
                src={kitchenImage}
                alt="Tom making a coffee, whilst DJ is enjoying one"
                class="aspect-square rounded-xl shadow-md object-cover my-4"
                loading="eager"
              />
              <LyricsOverlay />
            </div>
            <audio
              controls
              src={fruityXmasMp3}
              class="absolute bottom-2 left-2"
              data-target="song"
              transition:name="audio"
              transition:persist
            />
          </figure>
          <LyricsTranscript />

          <p class="mt-2 text-lg text-orange-600 dark:text-pink-400">
            The café{" "}
            <span data-target="tense" data-past="was">
              will be
            </span>{" "}
            open during the afternoon on the{" "}
            <strong
              class="text-orange-700 dark:text-pink-300"
              title="Sunday, 27 December"
            >
              third Christmas
            </strong>{" "}
            day, from{" "}
            <strong class="text-orange-700 dark:text-pink-300">12:00 to 17:28</strong>.
          </p>
          <Countdown />

          <template data-target="when-closed">
            <div class="grid grid-cols-1 gap-x-8 gap-y-6 sm:grid-cols-2">
              <div class="sm:col-span-2">
                <p class="mt-8 text-lg">
                  You can no longer RSVP to this event. See you again next time!
                </p>
              </div>
            </div>
          </template>

          <form
            action={successPage}
            name={formName}
            method="POST"
            data-netlify="true"
            data-netlify-recaptcha="true"
            class="mt-16"
          >
            <div class="grid grid-cols-1 gap-x-8 gap-y-6 sm:grid-cols-2">
              <div>
                <label for="first-name" class="block text-sm/6 font-semibold form-label">
                  First name{" "}
                  <span aria-hidden="true" class="text-pink-600 dark:text-orange-600">
                    *
                  </span>
                  <span class="sr-only">(required)</span>
                </label>
                <div class="mt-2.5">
                  <input
                    id="first-name"
                    type="text"
                    name="first-name"
                    autocomplete="given-name"
                    class="w-full rounded-md form-input"
                    required
                  />
                </div>
              </div>
              <div>
                <label for="last-name" class="block text-sm/6 font-semibold form-label">
                  Last name
                </label>
                <div class="mt-2.5">
                  <input
                    id="last-name"
                    type="text"
                    name="last-name"
                    autocomplete="family-name"
                    class="w-full rounded-md form-input"
                  />
                </div>
              </div>
              <div class="sm:col-span-2">
                <div class="flex justify-between text-sm/6">
                  <label for="email" class="block text-sm/6 font-semibold form-label">
                    Email
                  </label>
                  <p id="email-description" class="text-zinc-400 dark:text-zinc-500">
                    Optional
                  </p>
                </div>
                <div class="mt-2.5">
                  <input
                    id="email"
                    type="email"
                    name="email"
                    autocomplete="email"
                    class="w-full rounded-md form-input"
                    aria-describedby="email-description"
                  />
                </div>

                <p class="mt-2 text-zinc-700 dark:text-zinc-300 text-sm">
                  We're asking so we can update you if there are changes to this event.
                </p>
              </div>
              <div class="sm:col-span-2">
                <div class="flex justify-between text-sm/6">
                  <label for="phone" class="block font-semibold form-label">
                    Phone
                  </label>
                  <p id="phone-description" class="text-zinc-400 dark:text-zinc-500">
                    Optional
                  </p>
                </div>
                <div class="mt-2.5">
                  <input
                    id="phone"
                    type="tel"
                    name="phone"
                    autocomplete="tel"
                    aria-describedby="phone-description"
                    class="w-full rounded-md form-input"
                  />
                </div>

                <p class="mt-2 text-zinc-700 dark:text-zinc-300 text-sm">
                  We're asking so we can update you if there are changes to this event.
                </p>
              </div>

              <fieldset class="sm:col-span-2 mt-8">
                <legend class="block text-xl font-semibold form-label">
                  Your RSVP: are we seeing you on{" "}
                  <strong class="font-semibold">
                    <span class="text-orange-700 dark:text-pink-300">Sunday,</span>{" "}
                    <span class="text-orange-600 dark:text-pink-400">27 December</span>
                  </strong>
                  ?
                </legend>

                <label class="sr-only" aria-hidden="true">
                  Your RSVP
                  <input
                    type="radio"
                    name="rsvp"
                    value=""
                    class="sr-only"
                    tabindex="-1"
                    disabled
                  />
                </label>

                <div class="mt-4 space-y-2 text-base/8 md:text-sm/6 tabular-nums dark:text-zinc-300">
                  <div class="flex gap-x-2.5">
                    <input
                      id="rsvp-no"
                      type="radio"
                      name="rsvp"
                      value="0"
                      required
                      class="relative mt-1 size-6 md:size-4 form-radio"
                    />
                    <label for="rsvp-no">
                      Unfortunately no, but please invite me again next time
                    </label>
                  </div>
                  <div class="flex gap-x-2.5">
                    <input
                      id="rsvp-never"
                      type="radio"
                      name="rsvp"
                      value="-0"
                      required
                      class="relative mt-1 size-6 md:size-4 form-radio"
                    />
                    <label for="rsvp-never">No, and do not invite me again</label>
                  </div>
                  <div class="flex gap-x-2.5">
                    <input
                      id="rsvp-1"
                      type="radio"
                      name="rsvp"
                      value="1"
                      class="relative mt-1 size-6 md:size-4 form-radio"
                    />
                    <label for="rsvp-1">Yes, by myself</label>
                  </div>
                  <div class="flex gap-x-2.5">
                    <input
                      id="rsvp-2"
                      type="radio"
                      name="rsvp"
                      value="2"
                      class="relative mt-1 size-6 md:size-4 form-radio"
                    />
                    <label for="rsvp-2">Yes, me +1</label>
                  </div>
                  <div class="flex gap-x-2.5">
                    <input
                      id="rsvp-3"
                      type="radio"
                      name="rsvp"
                      value="3"
                      class="relative mt-1 size-6 md:size-4 form-radio"
                    />
                    <label for="rsvp-3">Yes, me +2</label>
                  </div>
                  <div class="flex gap-x-2.5">
                    <input
                      id="rsvp-4"
                      type="radio"
                      name="rsvp"
                      value="4"
                      class="relative mt-1 size-6 md:size-4 form-radio"
                    />
                    <label for="rsvp-4">Yes, me +3</label>
                  </div>
                </div>

                <RsvpReaction />
              </fieldset>

              <fieldset class="sm:col-span-2 mt-2">
                <legend class="block text-xl font-semibold form-label">
                  Expected arrival
                </legend>

                <p class="mt-1 text-lg dark:text-zinc-300">
                  In order to assess if the city government is going to shut down our
                  friends-gathering, please indicate the time you would like to come. We
                  won't hold you to this, but it helps with planning!
                </p>

                <div class="grid grid-cols-1 gap-x-8 gap-y-6 sm:grid-cols-2 mt-4">
                  <div>
                    <label
                      for="time-arrival"
                      class="block text-sm/6 font-semibold form-label"
                    >
                      Time of arrival
                    </label>
                    <div class="mt-2.5">
                      <select
                        id="time-arrival"
                        name="time[start]"
                        class="w-full rounded-md form-select"
                      >
                        <option disabled selected>
                          (select an option)
                        </option>
                        <option value="12:00">Around 12:00</option>
                        <option value="13:00">Around 13:00</option>
                        <option value="14:00">Around 14:00</option>
                        <option value="15:00">Around 15:00</option>
                        <option value="16:00">Around 16:00</option>
                        <option value="17:00">Around 17:00</option>
                      </select>
                    </div>
                  </div>
                  <div>
                    <label
                      for="time-duration"
                      class="block text-sm/6 font-semibold form-label"
                    >
                      Desired duration of stay
                    </label>
                    <div class="mt-2.5">
                      <select
                        id="time-duration"
                        name="time[duration]"
                        class="w-full rounded-md form-select"
                      >
                        <option disabled selected>
                          (select an option)
                        </option>
                        <option value="45">45 minutes or less</option>
                        <option value="60">About an hour</option>
                        <option value="90">About 1.5 hours</option>
                        <option value="120">About 2 hours</option>
                        <option value="150">About 2.5 hours</option>
                        <option value="180" data-until-closing>
                          Until you kick me out
                        </option>
                      </select>
                    </div>
                  </div>
                </div>
              </fieldset>

              <fieldset class="sm:col-span-2 mt-2">
                <legend class="block text-xl font-semibold form-label">
                  Allergies &amp; intolerances
                </legend>

                <p class="mt-1 text-lg dark:text-zinc-300">
                  It's very important to us that your visit does not result in an
                  unexpected trip to the hospital, or hours on the toilet. Please indicate
                  your allergies and intolerances.
                </p>

                <label class="sr-only" aria-hidden="true">
                  Allergies &amp; intolerances
                  <input
                    type="checkbox"
                    name="allergens[]"
                    value=""
                    class="sr-only"
                    tabindex="-1"
                    disabled
                  />
                </label>

                <div class="mt-4 space-y-2 text-base/8 md:text-sm/6 tabular-nums dark:text-zinc-300">
                  <div class="flex gap-x-2.5">
                    <input
                      id="allergen-milk"
                      type="checkbox"
                      name="allergens[]"
                      value="milk"
                      class="relative mt-1 size-6 md:size-4 form-checkbox rounded-sm"
                    />
                    <label for="allergen-milk" class="form-label flex items-start">
                      <FormIcon name="milk" />
                      <span>Milk (any dairy or milk protein)</span>
                    </label>
                  </div>
                  <div class="flex gap-x-2.5">
                    <input
                      id="allergen-lactose"
                      type="checkbox"
                      name="allergens[]"
                      value="lactose"
                      class="relative mt-1 size-6 md:size-4 form-checkbox rounded-sm"
                    />
                    <label for="allergen-lactose" class="form-label flex items-start">
                      <FormIcon name="lactose" />
                      <span>Lactose</span>
                    </label>
                  </div>
                  <div class="flex gap-x-2.5">
                    <input
                      id="allergen-eggs"
                      type="checkbox"
                      name="allergens[]"
                      value="eggs"
                      class="relative mt-1 size-6 md:size-4 form-checkbox rounded-sm"
                    />
                    <label for="allergen-eggs" class="form-label flex items-start">
                      <FormIcon name="eggs" />
                      <span>Eggs</span>
                    </label>
                  </div>
                  <div class="flex gap-x-2.5">
                    <input
                      id="allergen-peanuts"
                      type="checkbox"
                      name="allergens[]"
                      value="peanuts"
                      class="relative mt-1 size-6 md:size-4 form-checkbox rounded-sm"
                    />
                    <label for="allergen-peanuts" class="form-label flex items-start">
                      <FormIcon name="peanuts" />
                      <span>Peanuts (whole, oil, etc.)</span>
                    </label>
                  </div>
                  <div class="flex gap-x-2.5">
                    <input
                      id="allergen-nuts"
                      type="checkbox"
                      name="allergens[]"
                      value="nuts"
                      class="relative mt-1 size-6 md:size-4 form-checkbox rounded-sm"
                    />
                    <label for="allergen-nuts" class="form-label flex items-start">
                      <FormIcon name="nuts" />
                      <span>Other nuts (whole, oil, etc.)</span>
                    </label>
                  </div>
                  <div class="flex gap-x-2.5">
                    <input
                      id="allergen-sesame"
                      type="checkbox"
                      name="allergens[]"
                      value="sesame"
                      class="relative mt-1 size-6 md:size-4 form-checkbox rounded-sm"
                    />
                    <label for="allergen-sesame" class="form-label flex items-start">
                      <FormIcon name="sesame" />
                      <span>Sesame seeds</span>
                    </label>
                  </div>
                  <div class="flex gap-x-2.5">
                    <input
                      id="allergen-gluten"
                      type="checkbox"
                      name="allergens[]"
                      value="gluten"
                      class="relative mt-1 size-6 md:size-4 form-checkbox rounded-sm"
                    />
                    <label for="allergen-gluten" class="form-label flex items-start">
                      <FormIcon name="gluten" />
                      <span>Wheat / Gluten</span>
                    </label>
                  </div>
                  <div class="flex gap-x-2.5">
                    <input
                      id="allergen-soy"
                      type="checkbox"
                      name="allergens[]"
                      value="soy"
                      class="relative mt-1 size-6 md:size-4 form-checkbox rounded-sm"
                    />
                    <label for="allergen-soy" class="form-label flex items-start">
                      <FormIcon name="soy" />
                      <span>Soy</span>
                    </label>
                  </div>
                  <div class="flex gap-x-2.5">
                    <input
                      id="allergen-alcohol"
                      type="checkbox"
                      name="allergens[]"
                      value="alcohol"
                      class="relative mt-1 size-6 md:size-4 form-checkbox rounded-sm"
                    />
                    <label for="allergen-alcohol" class="form-label flex items-start">
                      <FormIcon name="alcohol" />
                      <span>
                        Alcohol (including when processed, cooked, or as ingredient)
                      </span>
                    </label>
                  </div>

                  <div class="flex gap-x-2.5">
                    <input
                      id="allergen-vegan"
                      type="checkbox"
                      name="allergens[]"
                      value="vegan"
                      class="relative mt-1 size-6 md:size-4 form-checkbox rounded-sm"
                    />
                    <label for="allergen-vegan" class="form-label flex items-start">
                      <FormIcon name="vegan" />
                      <span>
                        Anything non-vegan (select if you are vegan, <em>not</em>{" "}
                        vegetarian)
                      </span>
                    </label>
                  </div>

                  <div class="flex gap-x-2.5">
                    <input
                      id="allergen-other"
                      type="checkbox"
                      name="allergens[]"
                      value="other"
                      class="relative mt-1 size-6 md:size-4 form-checkbox rounded-sm"
                    />
                    <label for="allergen-other" class="form-label flex items-start">
                      <FormIcon name="other" />
                      <span>
                        Other (use{" "}
                        <a href="#message" class="link">
                          comment field
                        </a>
                        )
                      </span>
                    </label>
                  </div>
                </div>
              </fieldset>

              <fieldset class="sm:col-span-2 mt-2">
                <legend class="block text-xl font-semibold form-label">
                  Preferred drink(s)
                </legend>

                <p class="mt-1 text-lg dark:text-zinc-300">
                  Indicate what you'd like to consume at our pop-up cafe. This helps us
                  plan ahead.
                </p>

                <label class="sr-only" aria-hidden="true">
                  Preferred drink(s)
                  <input
                    type="checkbox"
                    name="preferences[drinks][]"
                    value=""
                    class="sr-only"
                    tabindex="-1"
                    disabled
                  />
                </label>

                <div class="mt-4 space-y-2 text-base/8 md:text-sm/6 tabular-nums dark:text-zinc-300">
                  <div class="flex gap-x-2.5">
                    <input
                      id="preferences-espresso"
                      type="checkbox"
                      name="preferences[drinks][]"
                      value="espresso"
                      class="relative mt-1 size-6 md:size-4 form-checkbox rounded-sm"
                    />
                    <label for="preferences-espresso" class="form-label flex items-start">
                      <FormIcon name="espresso" />
                      <span>Espresso (medium roast)</span>
                    </label>
                  </div>
                  <div class="flex gap-x-2.5">
                    <input
                      id="preferences-cappuccino"
                      type="checkbox"
                      name="preferences[drinks][]"
                      value="cappuccino"
                      class="relative mt-1 size-6 md:size-4 form-checkbox rounded-sm"
                    />
                    <label
                      for="preferences-cappuccino"
                      class="form-label flex items-start"
                    >
                      <FormIcon name="cappuccino" />
                      <span>Cappuccino / Latte</span>
                    </label>
                  </div>
                  <div class="flex gap-x-2.5">
                    <input
                      id="preferences-filtered"
                      type="checkbox"
                      name="preferences[drinks][]"
                      value="filtered"
                      class="relative mt-1 size-6 md:size-4 form-checkbox rounded-sm"
                    />
                    <label for="preferences-filtered" class="form-label flex items-start">
                      <FormIcon name="filtered" />
                      <span>Filtered coffee (light roast)</span>
                    </label>
                  </div>
                  <div class="flex gap-x-2.5">
                    <input
                      id="preferences-chocolate"
                      type="checkbox"
                      name="preferences[drinks][]"
                      value="chocolate"
                      class="relative mt-1 size-6 md:size-4 form-checkbox rounded-sm"
                    />
                    <label
                      for="preferences-chocolate"
                      class="form-label flex items-start"
                    >
                      <FormIcon name="chocolate" />
                      <span>Hot chocolate</span>
                    </label>
                  </div>
                  <div class="flex gap-x-2.5">
                    <input
                      id="preferences-herbal-tea"
                      type="checkbox"
                      name="preferences[drinks][]"
                      value="tea"
                      class="relative mt-1 size-6 md:size-4 form-checkbox rounded-sm"
                    />
                    <label
                      for="preferences-herbal-tea"
                      class="form-label flex items-start"
                    >
                      <FormIcon name="herbal-tea" />
                      <span>Dried herbal tea</span>
                    </label>
                  </div>
                  <div class="flex gap-x-2.5">
                    <input
                      id="preferences-ginger-tea"
                      type="checkbox"
                      name="preferences[drinks][]"
                      value="ginger-tea"
                      class="relative mt-1 size-6 md:size-4 form-checkbox rounded-sm"
                    />
                    <label
                      for="preferences-ginger-tea"
                      class="form-label flex items-start"
                    >
                      <FormIcon name="ginger-tea" />
                      <span>Fresh ginger tea</span>
                    </label>
                  </div>
                  <div class="flex gap-x-2.5">
                    <input
                      id="preferences-mint-tea"
                      type="checkbox"
                      name="preferences[drinks][]"
                      value="mint-tea"
                      class="relative mt-1 size-6 md:size-4 form-checkbox rounded-sm"
                    />
                    <label for="preferences-mint-tea" class="form-label flex items-start">
                      <FormIcon name="mint-tea" />
                      <span>Fresh mint tea</span>
                    </label>
                  </div>
                  <div class="flex gap-x-2.5">
                    <input
                      id="preferences-alcohol"
                      type="checkbox"
                      name="preferences[drinks][]"
                      value="alcohol"
                      class="relative mt-1 size-6 md:size-4 form-checkbox rounded-sm"
                    />
                    <label for="preferences-alcohol" class="form-label flex items-start">
                      <FormIcon name="wine" />
                      <span>Alcoholic beverage</span>
                    </label>
                  </div>
                </div>
              </fieldset>

              <div class="sm:col-span-2">
                <div class="flex justify-between text-sm/6">
                  <label for="message" class="block text-sm/6 font-semibold form-label">
                    Additional comments
                  </label>
                  <p id="message-description" class="text-zinc-400 dark:text-zinc-500">
                    Max 500 characters
                  </p>
                </div>
                <div class="mt-2.5">
                  <textarea
                    id="message"
                    name="message"
                    rows="4"
                    aria-describedby="message-description"
                    class="w-full rounded-md form-input field-sizing-content min-h-24"
                    maxlength="500"
                  ></textarea>
                </div>
              </div>

              <OrderTicket />
            </div>

            <div class="mt-4" data-netlify-recaptcha="true"></div>

            <div class="mt-10 flex justify-between items-start border-t border-zinc-900/10 pt-8 dark:border-white/10 gap-2">
              <p class="dark:text-zinc-300">
                If you RSVPed yes, we will send our address and further details just
                before Christmas.
              </p>

              <button
                type="submit"
                class="transition shrink-0 rounded-md pointer bg-pink-600 dark:bg-orange-700 px-3.5 py-2.5 text-center text-sm font-semibold text-white shadow-xs hover:shadow-md active:shadow-none dark:shadow-lg dark:hover:shadow-xl dark:active:shadow-sm hover:bg-pink-500 dark:hover:bg-orange-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pink-600 dark:focus-visible:outline-orange-600 active:bg-pink-700 dark:active:bg-orange-800 hover:-translate-y-px active:translate-y-px"
              >
                Send RSVP
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <script
    data-astro-rerun
    data-target="variables"
    data-variable-event-gate={eventGate}
    data-variable-signup-gate={signupGate}
    data-variable-form-name={formName}
  >
    {
      const renderTime = new Date().getTime() / 1000;

      const variables = document.querySelector('[data-target="variables"]');
      const eventIsPast = renderTime > Number(variables.dataset.variableEventGate);
      const signupIsClosed = renderTime > Number(variables.dataset.variableSignupGate);

      if (eventIsPast) {
        document.querySelectorAll('[data-target="tense"]').forEach((node) => {
          node.innerText = node.dataset.past;
        });
      }

      if (signupIsClosed) {
        /** @type {HTMLTemplateElement} */
        const formReplacementTemplate = document.querySelector(
          'template[data-target="when-closed"]',
        );
        const formReplacement =
          formReplacementTemplate.content.firstElementChild.cloneNode(true);

        document
          .querySelector(`form[name="${variables.dataset.variableFormName}"]`)
          .replaceWith(formReplacement);
      }
    }
  </script>
</HtmlLayout>
