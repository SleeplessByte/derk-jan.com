---
import LinkPreview from "../../../components/LinkPreview.astro";
import LyricsTranscript from "../../../components/Lyrics/Transcript.astro";
import HtmlLayout from "../../../layouts/HtmlLayout.astro";
import CoverPlayer from "./_components/CoverPlayer/Component.astro";

import cover from "../../../assets/2026-rijndam-racers-cover.jpeg";
import lyrics from "../../../assets/audio/2027-rijndam-racers-theme.lyrics.json";
import themeM4a from "../../../assets/audio/2027-rijndam-racers-theme.m4a?url";
import themeMp3 from "../../../assets/audio/2027-rijndam-racers-theme.mp3";
import themeVtt from "../../../assets/audio/2027-rijndam-racers-theme.vtt?url";

const title = "Rijndam Racers";
const description = "The theme song of the Rijndam Racers, with its lyrics.";
const coverAlt =
  "The Rijndam Racers in their green team jerseys on a country road: half of them standing, half in their hand bikes, cheering.";
---

<HtmlLayout
  title={title}
  description={description}
  lang="en"
  class="song-page --rijndam-racers"
>
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
    <LinkPreview
      type="music.song"
      title={title}
      description={description}
      url={new URL(Astro.url.pathname, Astro.site)}
      image={{
        url: new URL("/prototypes/songs/rijndam-racers.jpg", Astro.site),
        width: 1200,
        height: 1200,
        alt: `${coverAlt} A sticker says “${title}”.`,
      }}
    />
  </Fragment>

  <main class="mx-auto max-w-md px-5 pt-12 pb-24 sm:pt-20">
    <header class="mb-6">
      <h1 class="text-4xl font-semibold tracking-tight text-zinc-900 dark:text-white">
        {title}
      </h1>
      <p class="mt-1 text-lg text-zinc-600 dark:text-zinc-300">Theme song</p>
    </header>

    <CoverPlayer
      cover={cover}
      alt={coverAlt}
      sources={[
        { src: themeM4a, type: 'audio/mp4; codecs="mp4a.40.2"' },
        { src: themeM4a, type: "audio/mp4" }, // for browsers failing on codecs
        { src: themeMp3, type: "audio/mpeg" },
      ]}
      captions={themeVtt}
      title={title}
      lyrics={lyrics}
    />
    <LyricsTranscript
      lyrics={lyrics}
      summary={`Read the lyrics of “${title}”`}
      hint="Choose a line to play the song from there."
    />
  </main>
</HtmlLayout>

<!-- Global, because HtmlLayout renders the body. -->
<style is:global>
  .song-page {
    background: var(--song-ground);

    /* "Deep": the jersey green in the cover, oklch(75% 0.17 148), made darker and deeper. */
    &.--rijndam-racers {
      --song-ground: oklch(94% 0.04 150);
      --lyrics-accent: oklch(44% 0.13 150);
      --lyrics-ring: oklch(52% 0.15 150);
      --lyrics-scrim: oklch(15% 0.04 150);
      /* "Bright": the jersey green, lighter and more vivid, for the bar over the photo. */
      --player-progress: oklch(84% 0.22 145);

      @media (prefers-color-scheme: dark) {
        --song-ground: oklch(19% 0.055 150);
        --lyrics-accent: oklch(80% 0.17 150);
        --lyrics-ring: oklch(75% 0.17 150);
      }
    }
  }
</style>
