---
import { getImage } from "astro:assets";
import LyricsTranscript from "../../../components/Lyrics/Transcript.astro";
import HtmlLayout from "../../../layouts/HtmlLayout.astro";
import CoverPlayer from "./_components/CoverPlayer/Component.astro";

import cover from "../../../assets/2026-rijndam-racers-cover.jpeg";
import lyrics from "../../../assets/audio/2027-rijndam-racers-theme.lyrics.json";
import themeMp3 from "../../../assets/audio/2027-rijndam-racers-theme.mp3";
import themeVtt from "../../../assets/audio/2027-rijndam-racers-theme.vtt?url";

const title = "Rijndam Racers";
const description = "The theme song of the Rijndam Racers, with its lyrics.";
const coverAlt =
  "The Rijndam Racers in their green team jerseys on a country road: half of them standing, half in their hand bikes, cheering.";

// A square crop, so that every link preview shows the same part of the cover.
const preview = await getImage({
  src: cover,
  width: 1200,
  height: 1200,
  fit: "cover",
  format: "jpeg",
});
---

<HtmlLayout
  title={title}
  description={description}
  lang="en"
  class="song-page --rijndam-racers"
>
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
    <meta property="og:type" content="music.song" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:image" content={new URL(preview.src, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="1200" />
    <meta property="og:image:alt" content={coverAlt} />
    <meta name="twitter:card" content="summary" />
  </Fragment>

  <main class="mx-auto max-w-md px-5 pt-12 pb-24 sm:pt-20">
    <header class="mb-6">
      <h1 class="text-4xl font-semibold tracking-tight text-zinc-900 dark:text-white">
        {title}
      </h1>
      <p class="mt-1 text-lg text-zinc-600 dark:text-zinc-300">Theme song</p>
    </header>

    <CoverPlayer
      cover={cover}
      alt={coverAlt}
      src={themeMp3}
      captions={themeVtt}
      title={title}
      lyrics={lyrics}
    />
    <LyricsTranscript
      lyrics={lyrics}
      summary={`Read the lyrics of “${title}”`}
      hint="Choose a line to play the song from there."
    />
  </main>
</HtmlLayout>

<!-- Global, because HtmlLayout renders the body. -->
<style is:global>
  .song-page {
    background: var(--song-ground);

    &.--rijndam-racers {
      --song-ground: var(--color-green-50);
      --lyrics-accent: var(--color-green-700);
      --lyrics-ring: var(--color-green-600);
      /* The team's green, as dark as the Gay Café scrim, so the overlay keeps its contrast. */
      --lyrics-scrim: oklch(17% 0.03 152);

      @media (prefers-color-scheme: dark) {
        --song-ground: var(--color-green-950);
        --lyrics-accent: var(--color-green-300);
        --lyrics-ring: var(--color-green-400);
      }
    }
  }
</style>
