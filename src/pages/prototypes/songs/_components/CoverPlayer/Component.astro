---
import { Image } from "astro:assets";
import LyricsOverlay from "../../../../../components/Lyrics/Overlay.astro";
import type { Lyrics } from "../../../../../components/Lyrics/types";

interface Props {
  cover: ImageMetadata;
  alt: string;
  src: string;
  /** The lyrics as WebVTT. */
  captions: string;
  title: string;
  lyrics: Lyrics;
}

const { cover, alt, src, captions, title, lyrics } = Astro.props;
const progressId = `cover-player-${crypto.randomUUID()}-progress`;

// Each spark leaves the tip at its own angle, distance and moment, so the stream looks random.
const sparks = [
  { rise: "-0.55rem", travel: "2.4rem", delay: "0s", twinkle: false },
  { rise: "0.4rem", travel: "1.8rem", delay: "0.1s", twinkle: true },
  { rise: "-0.2rem", travel: "3.2rem", delay: "0.2s", twinkle: false },
  { rise: "0.6rem", travel: "2.2rem", delay: "0.3s", twinkle: false },
  { rise: "-0.35rem", travel: "1.5rem", delay: "0.4s", twinkle: true },
  { rise: "0.15rem", travel: "2.8rem", delay: "0.5s", twinkle: false },
  { rise: "-0.6rem", travel: "2rem", delay: "0.6s", twinkle: true },
  { rise: "0.3rem", travel: "3rem", delay: "0.7s", twinkle: false },
];
---

<!-- The page sets --lyrics-ring, --lyrics-scrim and --player-progress on an ancestor. -->
<figure data-component="cover-player">
  <div class="stage">
    <Image
      src={cover}
      alt={alt}
      class="artwork"
      widths={[480, 960, 1440]}
      sizes="(min-width: 30rem) 28rem, 100vw"
      loading="eager"
    />
    <LyricsOverlay lyrics={lyrics} />
    <div class="loading" hidden>
      <label class="sr-only" for={progressId}>
        Loading “{title}”
      </label>
      <progress class="sr-only" id={progressId} max="1" value="0"></progress>
      <span class="rail" aria-hidden="true">
        <span class="loaded">
          {sparks.map(({ rise, travel, delay, twinkle }) => (
            <span
              class:list={["spark", { "--twinkle": twinkle }]}
              style={{ "--rise": rise, "--travel": travel, "--delay": delay }}
            />
          ))}
        </span>
      </span>
    </div>
    <button type="button" class="control" hidden>
      <span class="sr-only label --play">Play “{title}”</span>
      <span class="sr-only label --pause">Pause</span>
      <span class="sr-only label --replay">Play “{title}” again</span>
      <span class="disc">
        <svg
          class="icon --play"
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="currentColor"
        >
          <path d="M7 4.5v15a1 1 0 0 0 1.5.86l12.5-7.5a1 1 0 0 0 0-1.72L8.5 3.64A1 1 0 0 0 7 4.5"></path>
        </svg>
        <svg
          class="icon --replay"
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M3.5 12A8.5 8.5 0 1 0 6 6L3.5 8.5"></path>
          <path d="M3.5 4v4.5H8"></path>
        </svg>
      </span>
    </button>
  </div>
  <audio src={src} controls preload="none" data-target="song">
    <track kind="captions" src={captions} srclang="en" label={title} />
  </audio>
  <div class="problem text-zinc-700 dark:text-zinc-300" hidden>
    <div role="alert">
      <p class="title">Sorry, the song does not start.</p>
      <p>
        You can try the player above. Please also send these details to Derk-Jan, so the
        problem can be fixed.
      </p>
    </div>
    <pre class="details"></pre>
    <p class="actions">
      <button type="button" class="copy">
        Copy the details
      </button>
      <span aria-live="polite">
        <span class="status --copied" hidden>
          Copied.
        </span>
        <span class="status --failed" hidden>
          Copying did not work. Please send a screenshot instead.
        </span>
      </span>
    </p>
  </div>
</figure>

<script>
  import { setupCoverPlayer } from "./cover-player";

  setupCoverPlayer();
  document.addEventListener("astro:after-swap", setupCoverPlayer);
</script>

<style>
  [data-component="cover-player"] {
    --player-glyph: white;

    margin: 0;

    & .stage {
      position: relative;
      aspect-ratio: 1;
      border-radius: 0.75rem;
      box-shadow: 0 0.5rem 1.5rem
        color-mix(in oklch, var(--lyrics-scrim) 25%, transparent);
    }

    & .artwork {
      display: block;
      width: 100%;
      height: 100%;
      border-radius: inherit;
      object-fit: cover;
    }

    & .loading {
      --loaded: 0;
      --progress-glow: color-mix(
        in oklch,
        var(--player-progress),
        var(--player-glyph) 55%
      );
      --progress-tail: color-mix(
        in oklch,
        var(--player-progress),
        var(--lyrics-scrim) 25%
      );

      /* Covers the card, so that the flame and the sparks stay inside it. */
      position: absolute;
      inset: 0;
      overflow: hidden;
      border-radius: inherit;
      pointer-events: none;

      & .rail {
        position: absolute;
        inset-inline: 1.25rem;
        inset-block-end: 1.25rem;
        block-size: 0.375rem;
        border-radius: 999px;
        background: color-mix(in oklch, var(--lyrics-scrim) 60%, transparent);
        box-shadow: 0 0.125rem 0.5rem
          color-mix(in oklch, var(--lyrics-scrim) 40%, transparent);
      }

      & .loaded {
        position: relative;
        display: block;
        block-size: 100%;
        inline-size: calc(var(--loaded) * 100%);
        border-radius: inherit;
        opacity: min(1, var(--loaded) * 25);
        background: linear-gradient(
          to right,
          color-mix(in oklch, var(--progress-tail) 50%, transparent),
          var(--progress-tail) calc(100% - 6rem),
          var(--player-progress) calc(100% - 1.5rem),
          var(--progress-glow)
        );

        &::before {
          content: "";
          position: absolute;
          inset-inline-end: 0;
          inset-block-start: 50%;
          inline-size: min(4.5rem, 100%);
          block-size: 1.125rem;
          translate: 0 -50%;
          transform-origin: right center;
          background: radial-gradient(
            ellipse farthest-side at 100% 50%,
            color-mix(in oklch, var(--progress-glow) 85%, transparent),
            color-mix(in oklch, var(--player-progress) 45%, transparent) 45%,
            transparent
          );
        }

        &::after {
          content: "";
          position: absolute;
          inset-inline-end: -0.625rem;
          inset-block-start: 50%;
          inline-size: 1.25rem;
          aspect-ratio: 1;
          translate: 0 -50%;
          border-radius: 50%;
          background: radial-gradient(
            circle,
            var(--player-glyph) 0 15%,
            var(--progress-glow) 30%,
            color-mix(in oklch, var(--player-progress) 40%, transparent) 50%,
            transparent 70%
          );
        }
      }

      & .spark {
        display: none;
        position: absolute;
        inset-inline-end: 0;
        inset-block-start: 50%;
        inline-size: 0.625rem;
        block-size: 0.1875rem;
        border-radius: 999px;
        background: var(--player-progress);
        box-shadow: 0 0 0.25rem var(--player-progress);
        opacity: 0;

        &.--twinkle {
          inline-size: 0.25rem;
          block-size: 0.25rem;
          background: var(--progress-glow);
        }
      }

      @media (prefers-reduced-motion: no-preference) {
        & .loaded {
          transition: inline-size 0.2s linear;

          /* Two unequal rhythms make the head flicker like a flame. */
          &::before {
            animation: cover-player-flame 0.13s ease-in-out infinite alternate;
          }

          &::after {
            animation: cover-player-flare 0.17s ease-in-out infinite alternate;
          }
        }

        & .spark {
          display: block;
          animation: cover-player-spark 0.8s var(--delay) ease-out infinite;
        }
      }
    }

    & .control {
      position: absolute;
      inset: 0;
      display: grid;
      place-items: center;
      border-radius: inherit;
      cursor: pointer;

      &:focus-visible {
        outline: 3px solid var(--lyrics-ring);
        outline-offset: 3px;
      }
    }

    & .disc {
      display: grid;
      place-items: center;
      width: 5rem;
      aspect-ratio: 1;
      border: 2px solid color-mix(in oklch, var(--player-glyph) 85%, transparent);
      border-radius: 50%;
      background: color-mix(in oklch, var(--lyrics-scrim) 82%, transparent);
      color: var(--player-glyph);
      box-shadow: 0 0.25rem 1rem color-mix(in oklch, var(--lyrics-scrim) 40%, transparent);
      transition:
        opacity 0.3s ease,
        scale 0.3s ease;
    }

    & .icon {
      width: 2.25rem;

      &.--replay {
        display: none;
      }
    }

    & .label {
      &.--pause,
      &.--replay {
        display: none;
      }
    }

    & audio {
      width: 100%;
      margin-top: 1rem;
    }

    & .problem {
      margin-top: 1rem;
      padding: 1rem;
      border-inline-start: 4px solid var(--lyrics-accent);
      border-radius: 0.5rem;
      background: color-mix(in oklch, var(--lyrics-accent) 8%, transparent);

      & .title {
        margin-bottom: 0.25rem;
        color: var(--lyrics-accent);
        font-weight: 650;
      }
    }

    & .details {
      margin-block: 0.75rem;
      padding: 0.75rem;
      border-radius: 0.375rem;
      background: color-mix(in oklch, currentColor 8%, transparent);
      font-size: 0.8125rem;
      line-height: 1.5;
      white-space: pre-wrap;
      overflow-wrap: anywhere;
    }

    & .actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.75rem;
    }

    & .copy {
      padding: 0.375rem 0.875rem;
      border: 2px solid var(--lyrics-accent);
      border-radius: 999px;
      color: var(--lyrics-accent);
      font-weight: 600;
      cursor: pointer;

      &:hover {
        background: color-mix(in oklch, var(--lyrics-accent) 12%, transparent);
      }

      &:focus-visible {
        outline: 3px solid var(--lyrics-ring);
        outline-offset: 2px;
      }
    }

    &.--playing {
      & .disc {
        opacity: 0;
      }

      & .label {
        &.--play {
          display: none;
        }

        &.--pause {
          display: inline;
        }
      }
    }

    &.--ended {
      & .icon {
        &.--play {
          display: none;
        }

        &.--replay {
          display: block;
        }
      }

      & .label {
        &.--play {
          display: none;
        }

        &.--replay {
          display: inline;
        }
      }
    }

    @media (prefers-reduced-motion: no-preference) {
      & .control:hover .disc {
        scale: 1.08;
      }

      &.--playing .disc {
        scale: 0.85;
      }
    }
  }

  @keyframes cover-player-flame {
    from {
      opacity: 0.8;
      scale: 1 1;
    }
    to {
      opacity: 1;
      scale: 1.25 0.75;
    }
  }

  @keyframes cover-player-flare {
    from {
      scale: 0.9;
    }
    to {
      scale: 1.1;
    }
  }

  @keyframes cover-player-spark {
    from {
      opacity: 1;
      translate: 0 -50%;
      scale: 1;
    }
    60% {
      opacity: 0.9;
    }
    to {
      opacity: 0;
      translate: calc(-1 * var(--travel)) calc(-50% + var(--rise));
      scale: 0.4;
    }
  }
</style>
