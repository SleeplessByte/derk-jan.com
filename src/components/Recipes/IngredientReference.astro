---
import type { IngredientId } from "./i18n";
import IngredientButton from "./IngredientButton.astro";

/** Set by remark-ingredients.ts. */
interface Props {
  icon: IngredientId;
  name: string;
}

const { icon, name } = Astro.props;
---

<IngredientButton icon={icon} name={name} variant="inline">
  <strong>{name}</strong>
</IngredientButton>
