---
import { formatPeople } from "./amount";
import { localeOf, locales } from "./i18n";
import { fill } from "./i18n/fill";
import type { ServingsMessages } from "./servings";

interface Props {
  servings: number;
}

const { servings } = Astro.props;
const t = locales[localeOf(Astro.params.lang)];
const messages = {
  people: t.people,
  status: t.servings.status,
} satisfies ServingsMessages;
---

<div
  data-component="servings"
  data-servings={servings}
  data-messages={JSON.stringify(messages)}
>
  <p class="fallback">
    {fill(t.servings.for, { people: formatPeople(servings, t.people) })}
  </p>
  <div class="control" hidden>
    <label for="servings-people">{t.servings.label}</label>
    <button type="button" class="step --fewer">
      <span aria-hidden="true">-</span>
      <span class="sr-only">{t.servings.fewer}</span>
    </button>
    <input
      id="servings-people"
      class="people"
      type="number"
      inputmode="numeric"
      min="1"
      max="99"
      value={servings}
    />
    <button type="button" class="step --more">
      <span aria-hidden="true">+</span>
      <span class="sr-only">{t.servings.more}</span>
    </button>
  </div>
  <p class="status sr-only" aria-live="polite"></p>
</div>

<script>
  import { setupServings } from "./servings";

  document.addEventListener("astro:page-load", setupServings);
</script>

<style>
  /* Tailwind only emits the theme variables that the site's utilities use. */
  @reference "../../styles/global.css";

  [data-component="servings"] {
    --servings-border: --theme(--color-zinc-500 inline);
    --servings-field: --theme(--color-white inline);
    --servings-button: --theme(--color-zinc-50 inline);
    --servings-button-raised: --theme(--color-white inline);
    --servings-button-pressed: --theme(--color-zinc-100 inline);
    --servings-ring: --theme(--color-pink-500 inline);

    @media (prefers-color-scheme: dark) {
      --servings-field: --theme(--color-zinc-800 inline);
      --servings-button: --theme(--color-zinc-800 inline);
      --servings-button-raised: --theme(--color-zinc-700 inline);
      --servings-button-pressed: --theme(--color-zinc-900 inline);
      --servings-ring: --theme(--color-yellow-500 inline);
    }

    & .control {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    & label {
      margin-inline-end: 0.25rem;
      font-weight: 600;
    }

    & .step,
    & .people {
      block-size: 2.75rem;
      border: 1px solid var(--servings-border);
      border-radius: 0.375rem;
      color: inherit;

      &:focus-visible {
        outline: 2px solid var(--servings-ring);
        outline-offset: 2px;
      }
    }

    & .step {
      inline-size: 2.75rem;
      font-size: 1.5rem;
      line-height: 1;
      background: var(--servings-button);
      box-shadow: --theme(--shadow-xs inline);
      transition-property: background-color, box-shadow, translate;
      transition-duration: 150ms;

      /* Without hover, a tap would leave the hover state on. */
      @media (hover: hover) {
        &:hover {
          background: var(--servings-button-raised);
          box-shadow: --theme(--shadow-sm inline);
        }
      }

      &:active {
        background: var(--servings-button-pressed);
        box-shadow: none;
      }

      @media (prefers-reduced-motion: no-preference) {
        @media (hover: hover) {
          &:hover {
            translate: 0 -1px;
          }
        }

        &:active {
          translate: 0 1px;
        }
      }
    }

    & .people {
      inline-size: 4.5rem;
      background: var(--servings-field);
      text-align: center;
      font-size: 1.125rem;
    }
  }
</style>
