---
import { formatIngredient, type IngredientData } from "./amount";
import { localeOf } from "./i18n";
import IngredientButton from "./IngredientButton.astro";

interface Props {
  /** The ingredient as JSON, from remark-ingredients.ts. */
  data: string;
}

const { data } = Astro.props;
const lang = localeOf(Astro.params.lang);
const ingredient = JSON.parse(data) as IngredientData;
---

<IngredientButton icon={ingredient.id} name={ingredient.name} variant="inline">
  <strong data-ingredient={data}>{formatIngredient(ingredient, 1, { lang })}</strong>
</IngredientButton>
