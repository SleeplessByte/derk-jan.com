{
  "cSpell.words": [
    "bounceb",
    "bouncel",
    "Codepen",
    "colour",
    "colours",
    "Derk",
    "exercism",
    "figcaption",
    "frontmatter",
    "grayscale",
    "intolerances",
    "Karrenbeld",
    "microsite",
    "Monkeypatch",
    "neighbours",
    "noreferrer",
    "nums",
    "oklch",
    "pescetarian",
    "rasterises",
    "shiki",
    "shikijs"
  ],
  "cSpell.overrides": [
    {
      "filename": "**/_i18n/nl.json",
      "language": "en,nl"
    }
  ],
  "astro.content-intellisense": true,
  "mdx.validate.validateDuplicateLinkDefinitions": "hint",
  "mdx.validate.validateFileLinks": "warning",
  "mdx.validate.validateFragmentLinks": "warning",
  "mdx.validate.validateMarkdownFileLinkFragments": "warning",
  "mdx.validate.validateReferences": "error",
  "mdx.validate.validateUnusedLinkDefinitions": "warning",
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "prettier.prettierPath": "./node_modules/prettier",
  "[mdx]": {
    "editor.defaultFormatter": "unifiedjs.vscode-mdx"
  }
}
